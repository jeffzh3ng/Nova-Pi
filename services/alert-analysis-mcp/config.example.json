{
  "server": {
    "host": "127.0.0.1",
    "port": 8765
  },
  "llm": {
    "mode": "direct",
    "baseUrl": "https://api.deepseek.com/",
    "apiKeyEnv": "ALERT_ANALYSIS_LLM_API_KEY",
    "apiKey": "",
    "model": "deepseek-v4-pro",
    "timeoutSeconds": 60,
    "maxTokens": 4096,
    "temperature": 0.1
  },
  "tools": {
    "tsharkPath": "C:\\Program Files\\Wireshark\\tshark.exe",
    "capinfosPath": "C:\\Program Files\\Wireshark\\capinfos.exe",
    "tcpdumpPath": "tcpdump",
    "pcapTimeoutSeconds": 20,
    "maxPcapOutputChars": 50000,
    "maxPcapPackets": 200
  },
  "ocr": {
    "engine": "glm-ocr",
    "fallbackToTesseract": true,
    "toolType": "hand_write",
    "languageType": "CHN_ENG",
    "provider": {
      "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
      "apiKeyEnv": "GLM_OCR_API_KEY",
      "apiKey": "",
      "timeoutSeconds": 60
    },
    "tesseractPath": "C:\\Program Files\\Tesseract-OCR\\tesseract.exe",
    "language": "chi_sim+eng",
    "pageSegmentationMode": 6,
    "timeoutSeconds": 60,
    "maxOutputChars": 12000
  },
  "threatIntel": {
    "provider": "threatbook",
    "threatbookApiKeyEnv": "THREATBOOK_API_KEY",
    "threatbookApiKey": "",
    "requestIntervalSeconds": 1.0,
    "timeoutSeconds": 20
  }
}
