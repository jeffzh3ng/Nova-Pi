{
  "name": "@nova-pi/host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "bin": {
    "nova-pi-host": "./dist/main.js"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/main.ts --format esm --target node22 --clean --sourcemap",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 src/mcp/client.test.ts src/mcp/client.integration.test.ts src/mcp/extension.integration.test.ts src/mcp/payload.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.82.1",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
